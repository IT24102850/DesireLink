# Production settings for docker-compose. Copy to .env.production on the server.
# Fill secrets with:  docker run --rm -v "$PWD":/w -w /w node:22-slim node scripts/gen-secrets.js

DOMAIN=desirelink.lk
POSTGRES_PASSWORD=
NIC_ENC_KEY=
HMAC_KEY=

ADMIN_EMAIL=you@yourdomain.lk
ADMIN_PASSWORD=

# Transactional email (required in production). Any SMTP works: Brevo, Mailgun, Postmark, Zoho, SES.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DesireLink <no-reply@desirelink.lk>

# Cloudflare Turnstile (recommended) https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

VITE_CONTACT_EMAIL=support@desirelink.lk
