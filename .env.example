# Copy to .env and fill in. Generate secrets with:  npm run gen-secrets
# NEVER commit .env. NEVER lose NIC_ENC_KEY (stored NICs become unreadable).

NODE_ENV=development
PORT=4000
# Public URL of the site. Must be https:// in production.
APP_URL=http://localhost:5173

# Local dev DB started by `npm run dev` (embedded Postgres on :54329).
DATABASE_URL=postgresql://desirelink:desirelink@localhost:54329/desirelink

# 32-byte hex keys (64 hex chars)
NIC_ENC_KEY=
HMAC_KEY=

# First admin, created on startup if it doesn't exist (password >= 12 chars).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Email (codes + notifications). Without SMTP, emails are printed to the server log (dev only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=DesireLink <no-reply@yourdomain.lk>
# ALLOW_CONSOLE_MAIL=true   # staging only

# Cloudflare Turnstile CAPTCHA (optional; enabled when both are set)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact email shown in Terms/Privacy (build-time)
VITE_CONTACT_EMAIL=support@yourdomain.lk

# Where uploads are stored (mount as a persistent volume in production)
DATA_DIR=./data
# Number of reverse proxies in front of the app (Caddy = 1)
# TRUST_PROXY=1
