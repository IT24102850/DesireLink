# Automatic HTTPS via Let's Encrypt. Point the domain's A/AAAA records at the
# server before starting. www redirects to the bare domain.
{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 50MB
	}
	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto {scheme}
	}
	log {
		output stdout
		format console
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
